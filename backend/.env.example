# ── Server ───────────────────────────────────────────────
PORT=
HOST=
NODE_ENV=
LOG_LEVEL=
CORS_ORIGIN=

# ── Admin ────────────────────────────────────────────────
ADMIN_API_TOKEN=

# ── Аутентификация (SSO) ─────────────────────────────────
AUTH_MODE=
FRONTEND_URL=
SESSION_SECRET=

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ── VPN / подписки ───────────────────────────────────────
VPN_DEFAULT_TTL_DAYS=
VPN_DEFAULT_TRAFFIC_LIMIT_GB=150

# Health-check нод (фоновый планировщик)
NODE_HEALTH_INTERVAL_MS=30000
NODE_HEALTH_TIMEOUT_MS=5000
NODE_HEALTH_FAIL_THRESHOLD=2
PUBLIC_BASE_URL=

# ── Вход в приложение по QR ──────────────────────────────────────────────────
# Время жизни QR-кода и срок действия токена устройства.
APP_QR_TTL_SECONDS=180
APP_TOKEN_TTL_DAYS=90
# Сколько устройств можно подключить к одному аккаунту по умолчанию.
APP_DEVICE_LIMIT=5
# Deep-link, который кодируется в QR. {code} заменяется на одноразовый код.
# Приложение должно уметь разбирать этот адрес.
APP_LOGIN_DEEPLINK=dogma://login?code={code}

# ── Страница /download и клиенты ─────────────────────────────────────────────
# Вариант 1: внешние ссылки (GitHub Releases, CDN).
#ANDROID_CLIENT_URL=
#ANDROID_CLIENT_VERSION=
#ANDROID_CLIENT_REQUIREMENTS=Android 8.0+
#ANDROID_CLIENT_SHA256=
#WINDOWS_CLIENT_URL=
#WINDOWS_CLIENT_VERSION=
#WINDOWS_CLIENT_REQUIREMENTS=Windows 10/11 (x64)
#WINDOWS_CLIENT_SHA256=
# Вариант 2: локальные файлы. По умолчанию — backend/public/downloads.
# Сервис берёт самый свежий .apk и .exe/.msi из каталога.
#CLIENT_DOWNLOAD_DIR=

# ── Авто-деплой нод: SSH-доступ портала к RU-релею ─────────
RU_INTERMEDIATE_HOST=
RU_INTERMEDIATE_SSH_PORT=
RU_INTERMEDIATE_SSH_USER=
RU_INTERMEDIATE_SSH_KEY_PATH=

# ── Деплой нод (WireGuard / Hysteria2) ───────────────────
WG_TUNNEL_NETWORK=
WG_LISTEN_PORT=
HYSTERIA_DOCKER_IMAGE=
SUBSCRIPTION_ENC_SECRET=

# VLESS + Reality (второй вход для Xray-клиентов, напр. Happ)
VLESS_HOST=
VLESS_PORT=
# VLESS_PUBLIC_KEY=dfKqhzN6KQOC7fH3JIW-D9UB_jXdY5K3dZLnuiDi73o
VLESS_SHORT_ID=
VLESS_SNI=
VLESS_FP=
VLESS_FLOW=
XRAY_SYNC_SECRET=

# PostgreSQL (shared across HA instances)
DATABASE_URL=
DATABASE_SSL=

# Redis (shared sessions)
REDIS_URL=

