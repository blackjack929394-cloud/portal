# DOMAIN задаётся из окружения (compose). По умолчанию — публичный домен сервера.
# Caddy сам выпустит/обновит Let's Encrypt для 192-144-56-63.sslip.io.
{$DOMAIN:192-144-56-63.sslip.io} {
	encode gzip

	# API и аутентификация -> бэкенд
	@backend path /api/* /auth/* /health
	handle @backend {
		reverse_proxy backend:8080
	}

	# Всё остальное -> собранный SPA
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
